---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import KnowledgeLayout from '../../layouts/KnowledgeLayout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('knowledge');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'knowledge'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const reviewedAt = entry.data.reviewedAt.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
---

<KnowledgeLayout title={entry.data.title} description={entry.data.description}>
  <article class="article-page">
    <header class="article-header article-shell">
      <a class="back-link" href="/knowledge/">← All knowledge</a>
      <p class="eyebrow">{entry.data.category}</p>
      <h1>{entry.data.title}</h1>
      <p class="article-deck">{entry.data.description}</p>
      <div class="article-meta">
        <span>Reviewed {reviewedAt}</span>
        <span>{entry.data.tags.join(' · ')}</span>
      </div>
    </header>
    <div class="article-body article-shell">
      <Content />
    </div>
  </article>
</KnowledgeLayout>