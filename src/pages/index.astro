---
import '../styles/global.css';

const email = 'hakbean0728@gmail.com';
const navItems = [
  { label: 'About', href: '#about' },
  { label: 'Knowledge', href: '/knowledge/' },
  { label: 'Project', href: '/projects/' },
  { label: 'Contact', href: '#contact' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Gaku Chen is an Azure Support Engineer in Tokyo with experience in cloud infrastructure, application integration, and enterprise technical support." />
    <meta name="theme-color" content="#171816" />
    <meta property="og:title" content="Gaku Chen | Azure Support Engineer" />
    <meta property="og:description" content="Azure support, application integration, and enterprise troubleshooting." />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="https://images.unsplash.com/photo-1558494949-ef010cbdcc31?auto=format&fit=crop&w=1200&q=85" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <title>Gaku Chen | Azure Support Engineer</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>

    <header class="site-header" data-header>
      <nav class="nav-shell" aria-label="Main navigation">
        <a class="brand" href="#top" aria-label="Gaku Chen, back to top">Gaku<span class="brand-mark">.</span></a>
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="primary-navigation" aria-label="Open navigation" data-menu-toggle>
          <span></span>
        </button>
        <ul class="nav-links" id="primary-navigation" data-menu>
          {navItems.map((item) => (
            <li><a href={item.href} data-nav-link>{item.label}</a></li>
          ))}
        </ul>
      </nav>
    </header>

    <main id="main-content">
      <section class="hero" id="top" aria-labelledby="hero-title">
        <div class="hero-inner">
          <p class="eyebrow">Azure Support Engineer · Tokyo</p>
          <h1 id="hero-title">Gaku Chen</h1>
          <p class="hero-lede">I work in enterprise technical support, with experience in Azure infrastructure and application integration.</p>
          <div class="hero-actions">
            <a class="button primary" href="#contact">Start a conversation <span aria-hidden="true">↘</span></a>
            <a class="button" href="#about">More about me <span aria-hidden="true">↓</span></a>
          </div>
        </div>
      </section>

      <section class="section" id="about" aria-labelledby="about-title">
        <div class="section-inner">
          <div class="section-heading">
            <span class="section-number">01 / About</span>
            <h2 id="about-title">Work, technology, and interests.</h2>
          </div>
          <div class="about-grid">
            <figure class="portrait-panel">
              <img src="https://images.unsplash.com/photo-1555066931-4365d14bab8c?auto=format&fit=crop&w=1000&q=82" alt="Code displayed on a computer screen" loading="lazy" />
            </figure>
            <div class="about-copy">
              <p class="lead">I am an Azure Support Engineer based in Tokyo, working with enterprise customers on cloud infrastructure and hybrid environment issues.</p>
              <p>Before joining Microsoft, I supported MuleSoft products at Salesforce and worked on API development and integration-product research at NTT DATA.</p>
              <p>I am passionate about AI-assisted programming and use Microsoft 365 Copilot and GitHub Copilot extensively in my daily work. My long-term goal is to grow toward an AI Engineer, Solution Architect, or Solution Engineer role.</p>
              <p>Outside work, I enjoy boxing, meeting people, exchanging ideas about technology, and investing in the U.S. stock market.</p>
            </div>
          </div>
        </div>
      </section>

      <section class="section" id="experience" aria-labelledby="experience-title">
        <div class="section-inner">
          <div class="section-heading">
            <span class="section-number">02 / Experience</span>
            <h2 id="experience-title">Professional experience.</h2>
          </div>

          <div class="experience-list">
            <article class="experience-row">
              <div class="experience-meta">Jun 2025 — Present<br />Microsoft Japan</div>
              <div>
                <h3>Azure Support Engineer</h3>
                <p>Support enterprise customers across Azure NetApp Files, Azure VMware Solution, HCX and NSX, Azure Monitor for SAP, and hybrid networking and security scenarios.</p>
              </div>
            </article>
            <article class="experience-row">
              <div class="experience-meta">Jan 2023 — May 2025<br />Salesforce Japan</div>
              <div>
                <h3>Technical Support Engineer, MuleSoft</h3>
                <p>Troubleshot enterprise production issues involving the JVM, networking, Kubernetes, and application integration, and worked with engineering teams on software defects.</p>
              </div>
            </article>
            <article class="experience-row">
              <div class="experience-meta">Apr 2021 — Dec 2022<br />NTT DATA</div>
              <div>
                <h3>MuleSoft Developer</h3>
                <p>Designed and developed REST APIs with MuleSoft and documented services for internal knowledge sharing.</p>
              </div>
            </article>
          </div>

          <div class="skills" aria-label="Selected skills">
            <article class="skill-group">
              <h3>Cloud & Infrastructure</h3>
              <ul>
                <li>Azure NetApp Files & Azure VMware Solution</li>
                <li>VMware, Kubernetes & Docker</li>
                <li>TCP/IP, HTTP/HTTPS, TLS & LDAP</li>
              </ul>
            </article>
            <article class="skill-group">
              <h3>Software & Integration</h3>
              <ul>
                <li>MuleSoft & REST APIs</li>
                <li>Python, Java & SQL</li>
                <li>Technical troubleshooting</li>
              </ul>
            </article>
            <article class="skill-group">
              <h3>AI & Languages</h3>
              <ul>
                <li>Microsoft 365 Copilot & GitHub Copilot</li>
                <li>Chinese & Korean — Native level</li>
                <li>Japanese & English — Business level</li>
              </ul>
            </article>
          </div>
        </div>
      </section>

      <section class="section contact-section" id="contact" aria-labelledby="contact-title">
        <div class="section-inner">
          <span class="section-number">03 / Contact</span>
          <h2 id="contact-title">Let's connect.</h2>
          <p class="contact-lede">I enjoy meeting new people, talking about technology, and investing in the U.S. stock market. Feel free to get in touch.</p>
          <div class="contact-actions">
            <a class="button primary" href={`mailto:${email}`}>Send an email <span aria-hidden="true">↗</span></a>
            <button class="button" type="button" data-copy-email data-email={email}>Copy email</button>
          </div>
          <ul class="social-list">
            <li><a href="https://github.com/Sugoigaku" target="_blank" rel="noreferrer">GitHub ↗</a></li>
          </ul>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="footer-inner">
        <span>© 2026 Gaku Chen</span>
        <span>Azure · Integration · Technology</span>
      </div>
    </footer>

    <div class="toast" role="status" aria-live="polite" hidden data-toast>Email copied to clipboard</div>

    <script>
      const header = document.querySelector('[data-header]');
      const menuToggle = document.querySelector('[data-menu-toggle]');
      const menu = document.querySelector('[data-menu]');
      const navLinks = document.querySelectorAll('[data-nav-link]');
      const copyButton = document.querySelector('[data-copy-email]');
      const toast = document.querySelector('[data-toast]');

      const closeMenu = () => {
        menu?.classList.remove('open');
        document.body.classList.remove('menu-open');
        menuToggle?.setAttribute('aria-expanded', 'false');
        menuToggle?.setAttribute('aria-label', 'Open navigation');
      };

      menuToggle?.addEventListener('click', () => {
        const willOpen = menuToggle.getAttribute('aria-expanded') !== 'true';
        menu?.classList.toggle('open', willOpen);
        document.body.classList.toggle('menu-open', willOpen);
        menuToggle.setAttribute('aria-expanded', String(willOpen));
        menuToggle.setAttribute('aria-label', willOpen ? 'Close navigation' : 'Open navigation');
      });

      navLinks.forEach((link) => link.addEventListener('click', closeMenu));

      const updateHeader = () => header?.classList.toggle('scrolled', window.scrollY > 40);
      updateHeader();
      window.addEventListener('scroll', updateHeader, { passive: true });

      const sections = [...document.querySelectorAll('main section[id]')];
      const observer = new IntersectionObserver((entries) => {
        const visible = entries.find((entry) => entry.isIntersecting);
        if (!visible) return;
        navLinks.forEach((link) => {
          const isCurrent = link.getAttribute('href') === `#${visible.target.id}`;
          if (isCurrent) link.setAttribute('aria-current', 'true');
          else link.removeAttribute('aria-current');
        });
      }, { rootMargin: '-25% 0px -65% 0px' });
      sections.forEach((section) => observer.observe(section));

      copyButton?.addEventListener('click', async () => {
        const emailAddress = copyButton.getAttribute('data-email');
        if (!emailAddress) return;
        try {
          await navigator.clipboard.writeText(emailAddress);
          if (toast instanceof HTMLElement) {
            toast.hidden = false;
            window.setTimeout(() => { toast.hidden = true; }, 2200);
          }
        } catch {
          window.location.href = `mailto:${emailAddress}`;
        }
      });
    </script>
  </body>
</html>